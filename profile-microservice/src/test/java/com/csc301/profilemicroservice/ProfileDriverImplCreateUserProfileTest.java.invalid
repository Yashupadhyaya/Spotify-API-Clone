package com.csc301.profilemicroservice;
import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.Transaction;
import org.junit.jupiter.api.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import org.neo4j.driver.v1.Record;
import org.neo4j.driver.v1.StatementResult;
import org.springframework.stereotype.Repository;

// Import for driver, session, and transaction
public class ProfileDriverImplCreateUserProfileTest {
    @Mock
    private Driver driver;
    @Mock
    private Session session;
    @Mock
    private Transaction tx;
  
    @InjectMocks
    private ProfileDriverImpl profileDriverImpl;
    
    
    @BeforeEach
    public void setup() {
        MockitoAnnotations.initMocks(this);
        when(driver.session()).thenReturn(session);
        when(session.beginTransaction()).thenReturn(tx);
    }
    @Tag("valid")
    @Test
    public void testForAllValidParameters() {
        String userName = "TestUser";
        String fullName = "Test Full Name";
        String password = "password";
        DbQueryStatus result = profileDriverImpl.createUserProfile(userName, fullName, password);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
    }
    @Tag("invalid")
    @Test
    public void testForNullParameters() {
        String userName = null;
        String fullName = null;
        String password = null;
        DbQueryStatus result = profileDriverImpl.createUserProfile(userName, fullName, password);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Tag("invalid")
    @Test
    public void testForDatabaseError() {
        String userName = "TestUser";
        String fullName = "Test Full Name";
        String password = "password";
        doThrow(new RuntimeException()).when(session).writeTransaction(any());
        DbQueryStatus result = profileDriverImpl.createUserProfile(userName, fullName, password);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
}