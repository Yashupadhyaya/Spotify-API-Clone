package com.csc301.profilemicroservice;
import java.util.Map;
import java.util.HashMap;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import org.neo4j.driver.v1.Driver;
import org.neo4j.driver.v1.Session;
import org.neo4j.driver.v1.Transaction;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import java.util.ArrayList;
import java.util.List;
import org.neo4j.driver.v1.Record;
import org.neo4j.driver.v1.StatementResult;
import org.springframework.stereotype.Repository;

@ExtendWith(MockitoExtension.class)
public class ProfileDriverImplCreateUserProfileTest {
    @Mock
    private Driver driver;
    @Mock
    private Session session;
    @Mock
    private Transaction transaction;
    @InjectMocks
    ProfileDriverImpl profileDriver;
    private Map<String, Object> params;
    @BeforeEach
    public void setup() {
        params = new HashMap<>();
        params.put("userName", "testUser");
        params.put("fullName", "User Test");
        params.put("password", "pass123");
        params.put("plName", "testUser-favourites");
    }
    @Test
    @Tag("valid")
    public void testForAllValidParameters() {
        when(driver.session()).thenReturn(session);
        when(session.writeTransaction(any())).thenReturn(null);
        DbQueryStatus result = profileDriver.createUserProfile("testUser", "User Test", "pass123");
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void testForNullParameters() {
        DbQueryStatus result = profileDriver.createUserProfile(null, null, null);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
    @Test
    @Tag("integration")
    public void testForDatabaseError() {
        when(driver.session()).thenReturn(session);
        when(session.writeTransaction(any())).thenThrow(new RuntimeException("Database Error"));
        DbQueryStatus result = profileDriver.createUserProfile("testUser", "User Test", "pass123");
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
    }
}