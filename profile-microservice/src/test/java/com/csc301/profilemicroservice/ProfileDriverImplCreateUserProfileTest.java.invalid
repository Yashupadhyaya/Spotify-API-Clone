public class ProfileDriverImplCreateUserProfileTest {
  
  private ProfileDriverImpl profileDriver;
  private Session session;
  @BeforeEach
  public void setup() {
    Driver driver = mock(Driver.class);
    session = mock(Session.class);
    
    profileDriver = new ProfileDriverImpl(driver);
  }
  @Test
  @Tag("valid")
  public void shouldCreateUserProfileSuccessfully() {
    String userName = "userName";
    String fullName = "fullName";
    String password = "password";
    DbQueryStatus result = profileDriver.createUserProfile(userName, fullName, password);
    
    assertEquals("POST", result.getMessage());
    assertEquals(DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
  }
  @Test
  @Tag("invalid")
  public void shouldReturnErrorWhenUserNameIsNull() {
    String userName = null;
    String fullName = "fullName";
    String password = "password";
