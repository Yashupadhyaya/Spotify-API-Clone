package com.csc301.profilemicroservice;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import javax.servlet.http.HttpServletRequest;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;
import org.springframework.http.HttpStatus;
import okhttp3.RequestBody;
import java.util.Map;

public class UtilsGetUrlTest {
    @Test
    @Tag("valid")
    public void validateUrlWithoutQueryParams() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com/test"));
        Mockito.when(mockRequest.getQueryString()).thenReturn(null);
        // Act
        String result = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("http://example.com/test", result);
    }
    @Test
    @Tag("valid")
    public void validateUrlWithQueryParams() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com/test"));
        Mockito.when(mockRequest.getQueryString()).thenReturn("key=value");
        // Act
        String result = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("http://example.com/test?key=value", result);
    }
    @Test
    @Tag("boundary")
    public void validateLongUrlWithQueryParams() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL())
                .thenReturn(new StringBuffer("http://example.com/test/this/is/a/very/long/url"));
        Mockito.when(mockRequest.getQueryString()).thenReturn("param1=value1&param2=value2");
        // Act
        String result = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("http://example.com/test/this/is/a/very/long/url?param1=value1&param2=value2", result);
    }
    @Test
    @Tag("invalid")
    public void validateNullRequestUrl() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(null); // Simulate invalid case
        Mockito.when(mockRequest.getQueryString()).thenReturn("param=value");
        // Act
        String result = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("null?param=value", result); // Expected output when URL is null
    }
    @Test
    @Tag("boundary")
    public void validateEmptyQueryString() {
        // Arrange
        HttpServletRequest mockRequest = Mockito.mock(HttpServletRequest.class);
        Mockito.when(mockRequest.getRequestURL()).thenReturn(new StringBuffer("http://example.com"));
        Mockito.when(mockRequest.getQueryString()).thenReturn(""); // Empty query string
        // Act
        String result = Utils.getUrl(mockRequest);
        // Assert
        assertEquals("http://example.com?", result); // Base URL + '?' for empty query string
    }
}