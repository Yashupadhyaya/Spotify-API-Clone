package com.csc301.songmicroservice;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.bson.types.ObjectId;
import org.junit.jupiter.api.*;
import java.util.HashMap;
import java.util.Map;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;
import com.fasterxml.jackson.annotation.JsonIgnore;

public class SongToStringTest {
    @Test
    @Tag("valid")
    public void verifyJsonRepresentationWithAllFieldsSet() {
        // Arrange
        ObjectId id = new ObjectId();
        Song song = new Song("Song Name", "Artist Name", "Album Name");
        song.setId(id);
        song.setSongAmountFavourites(100);
        // Act
        String actualJson = song.toString();
        // Assert
        assertTrue(actualJson.contains("\"id\":\"" + id.toHexString() + "\""));
        assertTrue(actualJson.contains("\"songName\":\"Song Name\""));
        assertTrue(actualJson.contains("\"songArtistFullName\":\"Artist Name\""));
        assertTrue(actualJson.contains("\"songAlbum\":\"Album Name\""));
        assertTrue(actualJson.contains("\"songAmountFavourites\":\"100\""));
    }
    @Test
    @Tag("invalid")
    public void verifyJsonRepresentationWithOnlyIdSet() {
        // Arrange
        ObjectId id = new ObjectId();
        Song song = new Song(null, null, null);
        song.setId(id);
        // Act
        String actualJson = song.toString();
        // Assert
        assertTrue(actualJson.contains("\"id\":\"" + id.toHexString() + "\""));
        assertTrue(actualJson.contains("\"songName\":\"null\""));
        assertTrue(actualJson.contains("\"songArtistFullName\":\"null\""));
        assertTrue(actualJson.contains("\"songAlbum\":\"null\""));
        assertTrue(actualJson.contains("\"songAmountFavourites\":\"0\""));
    }
    @Test
    @Tag("invalid")
    public void verifyJsonRepresentationWithIdNull() {
        // Arrange
        Song song = new Song("Song Name", "Artist Name", "Album Name");
        song.setSongAmountFavourites(100);
        song.setId(null); // _id is null
        // Act
        String actualJson = song.toString();
        // Assert
        assertTrue(actualJson.contains("\"id\":\"null\""));
        assertTrue(actualJson.contains("\"songName\":\"Song Name\""));
        assertTrue(actualJson.contains("\"songArtistFullName\":\"Artist Name\""));
        assertTrue(actualJson.contains("\"songAlbum\":\"Album Name\""));
        assertTrue(actualJson.contains("\"songAmountFavourites\":\"100\""));
    }
    @Test
    @Tag("boundary")
    public void verifyJsonRepresentationWithMaxFavouriteValue() {
        // Arrange
        ObjectId id = new ObjectId();
        Song song = new Song("Song Name", "Artist Name", "Album Name");
        song.setId(id);
        song.setSongAmountFavourites(Long.MAX_VALUE);
        // Act
        String actualJson = song.toString();
        // Assert
        assertTrue(actualJson.contains("\"id\":\"" + id.toHexString() + "\""));
        assertTrue(actualJson.contains("\"songName\":\"Song Name\""));
        assertTrue(actualJson.contains("\"songArtistFullName\":\"Artist Name\""));
        assertTrue(actualJson.contains("\"songAlbum\":\"Album Name\""));
        assertTrue(actualJson.contains("\"songAmountFavourites\":\"" + Long.MAX_VALUE + "\""));
    }
    @Test
    @Tag("invalid")
    public void verifyJsonRepresentationWithAllFieldsNull() {
        // Arrange
        Song song = new Song(null, null, null);
        song.setId(null); // _id is null
        // Act
        String actualJson = song.toString();
        // Assert
        assertTrue(actualJson.contains("\"id\":\"null\""));
        assertTrue(actualJson.contains("\"songName\":\"null\""));
        assertTrue(actualJson.contains("\"songArtistFullName\":\"null\""));
        assertTrue(actualJson.contains("\"songAlbum\":\"null\""));
        assertTrue(actualJson.contains("\"songAmountFavourites\":\"0\""));
    }
    @Test
    @Tag("boundary")
    public void verifyJsonRepresentationWithSpecialCharacters() {
        // Arrange
        ObjectId id = new ObjectId();
        Song song = new Song("Song \"Name\"", "Artist \"Name\"", "Album \"Name\"");
        song.setId(id);
        song.setSongAmountFavourites(50);
        // Act
        String actualJson = song.toString();
        // Assert
        assertTrue(actualJson.contains("\"id\":\"" + id.toHexString() + "\""));
        assertTrue(actualJson.contains("\"songName\":\"Song \\\"Name\\\"\""));
        assertTrue(actualJson.contains("\"songArtistFullName\":\"Artist \\\"Name\\\"\""));
        assertTrue(actualJson.contains("\"songAlbum\":\"Album \\\"Name\\\"\""));
        assertTrue(actualJson.contains("\"songAmountFavourites\":\"50\""));
    }
    @Test
    @Tag("boundary")
    public void verifyJsonRepresentationWithZeroFavourites() {
        // Arrange
        ObjectId id = new ObjectId();
        Song song = new Song("Zero Song", "Zero Artist", "Zero Album");
        song.setId(id);
        song.setSongAmountFavourites(0); // Edge case: 0 favourites
        // Act
        String actualJson = song.toString();
        // Assert
        assertTrue(actualJson.contains("\"id\":\"" + id.toHexString() + "\""));
        assertTrue(actualJson.contains("\"songName\":\"Zero Song\""));
        assertTrue(actualJson.contains("\"songArtistFullName\":\"Zero Artist\""));
        assertTrue(actualJson.contains("\"songAlbum\":\"Zero Album\""));
        assertTrue(actualJson.contains("\"songAmountFavourites\":\"0\""));
    }
    @Test
    @Tag("boundary")
    public void verifyJsonRepresentationWithWhiteSpaceFields() {
        // Arrange
        ObjectId id = new ObjectId();
        Song song = new Song("   Song Name   ", "   Artist Name   ", "   Album Name   ");
        song.setId(id);
        song.setSongAmountFavourites(30);
        // Act
        String actualJson = song.toString();
        // Assert
        assertTrue(actualJson.contains("\"id\":\"" + id.toHexString() + "\""));
        assertTrue(actualJson.contains("\"songName\":\"   Song Name   \""));
        assertTrue(actualJson.contains("\"songArtistFullName\":\"   Artist Name   \""));
        assertTrue(actualJson.contains("\"songAlbum\":\"   Album Name   \""));
        assertTrue(actualJson.contains("\"songAmountFavourites\":\"30\""));
    }
}