package com.csc301.songmicroservice;
import org.bson.types.ObjectId;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.springframework.data.mongodb.core.MongoTemplate;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import com.mongodb.client.result.DeleteResult;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

public class SongDalImplGetSongTitleByIdTest {
    private MongoTemplate mongoTemplate = Mockito.mock(MongoTemplate.class);
    private SongDalImpl songDal = new SongDalImpl(mongoTemplate);
    @Test
    @Tag("valid")
    public void returnSongTitleIfExists() {
        // Arrange
        String songId = "507f1f77bcf86cd799439011";
        Song mockSong = Mockito.mock(Song.class);
        Mockito.when(mockSong.getSongName()).thenReturn("Song Title");
        Mockito.when(mongoTemplate.findById(new ObjectId(songId), Song.class)).thenReturn(mockSong);
        // Act
        DbQueryStatus status = songDal.getSongTitleById(songId);
        // Assert
        assertEquals(status.getdbQueryExecResult(), songDal.OK);
        assertEquals("Song Title", status.getData(), "Expected song title");
    }
    @Test
    @Tag("invalid")
    public void returnErrorCodeIfSongDoesNotExist() {
        // Arrange
        String songId = "507f1f77bcf86cd799439012";
        Mockito.when(mongoTemplate.findById(new ObjectId(songId), Song.class)).thenReturn(null);
        // Act
        DbQueryStatus status = songDal.getSongTitleById(songId);
        // Assert
        assertEquals(status.getdbQueryExecResult(), songDal.ERR404);
        assertNull(status.getData(), "Expected null data");
    }
    @Test
    @Tag("invalid")
    public void returnErrorCodeForInvalidIdFormat() {
        // Arrange
        String invalidSongId = "InvalidId"; // TODO: Modify this value as needed for testing invalid IDs
        // Act
        DbQueryStatus status = songDal.getSongTitleById(invalidSongId);
        // Assert
        assertEquals(status.getdbQueryExecResult(), songDal.ERR);
        assertNull(status.getData(), "Expected null data");
    }
    @Test
    @Tag("integration")
    public void handleDatabaseAccessException() {
        // Arrange
        String songId = "507f1f77bcf86cd799439013";
        Mockito.when(mongoTemplate.findById(new ObjectId(songId), Song.class)).thenThrow(new RuntimeException("Database error"));
        // Act
        DbQueryStatus status = songDal.getSongTitleById(songId);
        // Assert
        assertEquals(status.getdbQueryExecResult(), songDal.ERR);
        assertNull(status.getData(), "Expected null data");
    }
    @Test
    @Tag("boundary")
    public void handleNullSongObjectReturnedFromDatabase() {
        // Arrange
        String songId = "507f1f77bcf86cd799439014";
        Mockito.when(mongoTemplate.findById(new ObjectId(songId), Song.class)).thenReturn(null);
        // Act
        DbQueryStatus status = songDal.getSongTitleById(songId);
        // Assert
        assertEquals(status.getdbQueryExecResult(), songDal.ERR404);
        assertNull(status.getData(), "Expected null data");
    }
    @Test
    @Tag("integration")
    public void concurrentCallsWithSameSongId() {
        // Arrange
        String songId = "507f1f77bcf86cd799439015";
        Song mockSong = Mockito.mock(Song.class);
        Mockito.when(mockSong.getSongName()).thenReturn("Concurrent Song Title");
        Mockito.when(mongoTemplate.findById(new ObjectId(songId), Song.class)).thenReturn(mockSong);
        
        Runnable task = () -> {
            DbQueryStatus status = songDal.getSongTitleById(songId);
            assertEquals(status.getdbQueryExecResult(), songDal.OK);
            assertEquals("Concurrent Song Title", status.getData(), "Expected song title");
        };
        // Act & Assert
        Thread thread1 = new Thread(task);
        Thread thread2 = new Thread(task);
        thread1.start();
        thread2.start();
        try {
            thread1.join();
            thread2.join();
        } catch (InterruptedException e) {
            fail("Threads interrupted");
        }
    }
    @Test
    @Tag("integration")
    public void concurrentCallsWithDifferentSongIds() {
        // Arrange
        String validSongId = "507f1f77bcf86cd799439016";
        String invalidSongId = "507f1f77bcf86cd799439017";
        Song mockSong = Mockito.mock(Song.class);
        Mockito.when(mockSong.getSongName()).thenReturn("Concurrent Different Song");
        
        Mockito.when(mongoTemplate.findById(new ObjectId(validSongId), Song.class)).thenReturn(mockSong);
        Mockito.when(mongoTemplate.findById(new ObjectId(invalidSongId), Song.class)).thenReturn(null);
        Runnable validTask = () -> {
            DbQueryStatus status = songDal.getSongTitleById(validSongId);
            assertEquals(status.getdbQueryExecResult(), songDal.OK);
            assertEquals("Concurrent Different Song", status.getData(), "Expected song title");
        };
        Runnable invalidTask = () -> {
            DbQueryStatus status = songDal.getSongTitleById(invalidSongId);
            assertEquals(status.getdbQueryExecResult(), songDal.ERR404);
            assertNull(status.getData(), "Expected null data");
        };
        // Act & Assert
        Thread thread1 = new Thread(validTask);
        Thread thread2 = new Thread(invalidTask);
        thread1.start();
        thread2.start();
        try {
            thread1.join();
            thread2.join();
        } catch (InterruptedException e) {
            fail("Threads interrupted");
        }
    }
}