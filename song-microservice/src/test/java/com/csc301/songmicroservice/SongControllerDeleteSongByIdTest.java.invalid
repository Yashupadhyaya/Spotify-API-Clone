package com.csc301.songmicroservice;
import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import java.util.Map;
import javax.servlet.http.HttpServletRequest;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import okhttp3.OkHttpClient;
import okhttp3.Request;
import okhttp3.Response;
import org.junit.jupiter.api.*;
import java.util.HashMap;
import org.json.JSONObject;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.bind.annotation.RestController;
import okhttp3.FormBody;
import okhttp3.RequestBody;

public class SongControllerDeleteSongByIdTest {
  
  @Mock
  private SongDal songDal;
  
  @Mock
  private HttpServletRequest request;
  @Mock
  private OkHttpClient client;
  @Mock
  private Response externalResponse;
  private SongController songController;
  @BeforeEach
  public void setup() {
    MockitoAnnotations.openMocks(this);
    songController = new SongController(songDal);
    songController.client = client; // Inject mocked OkHttpClient
  }
  @Test
  @Tag("valid")
  public void verifySuccessfulSongDeletion() throws Exception {
    when(songDal.deleteSongById(anyString())).thenReturn(new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK));
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/123"));
    when(externalResponse.body()).thenReturn(mock(Response.Body.class));
    when(externalResponse.body().string()).thenReturn("{\"status\": \"OK\"}");
    when(client.newCall(any(Request.class)).execute()).thenReturn(externalResponse);
    Map<String, Object> response = songController.deleteSongById("123", request);
    assertEquals("Success", response.get("message"));
    assertEquals("DELETE http://localhost:8080/songs/123", response.get("path"));
    assertEquals(DbQueryExecResult.QUERY_OK, response.get("status"));
  }
  @Test
  @Tag("invalid")
  public void handleNonExistentSongDeletion() {
    when(songDal.deleteSongById(anyString())).thenReturn(new DbQueryStatus("Song not found", DbQueryExecResult.QUERY_ERROR_NOT_FOUND));
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/456"));
    Map<String, Object> response = songController.deleteSongById("456", request);
    assertEquals("Song not found", response.get("message"));
    assertEquals("DELETE http://localhost:8080/songs/456", response.get("path"));
    assertEquals(DbQueryExecResult.QUERY_ERROR_NOT_FOUND, response.get("status"));
  }
  @Test
  @Tag("integration")
  public void handleExternalServiceFailure() throws Exception {
    when(songDal.deleteSongById(anyString())).thenReturn(new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK));
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/789"));
    when(client.newCall(any(Request.class)).execute()).thenThrow(new RuntimeException("External service failure"));
    Map<String, Object> response = songController.deleteSongById("789", request);
    assertEquals("Success", response.get("message"));
    assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, response.get("status"));
  }
  @Test
  @Tag("valid")
  public void verifyPathInResponseForDeletion() throws Exception {
    when(songDal.deleteSongById(anyString())).thenReturn(new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK));
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/100"));
    when(externalResponse.body()).thenReturn(mock(Response.Body.class));
    when(externalResponse.body().string()).thenReturn("{\"status\": \"OK\"}");
    when(client.newCall(any(Request.class)).execute()).thenReturn(externalResponse);
    Map<String, Object> response = songController.deleteSongById("100", request);
    assertEquals("DELETE http://localhost:8080/songs/100", response.get("path"));
  }
  @Test
  @Tag("invalid")
  public void handleNullSongId() {
    when(songDal.deleteSongById(anyString())).thenReturn(new DbQueryStatus("Invalid input", DbQueryExecResult.QUERY_ERROR_GENERIC));
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/null"));
    Map<String, Object> response = songController.deleteSongById(null, request);
    assertEquals("Invalid input", response.get("message"));
    assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, response.get("status"));
  }
  @Test
  @Tag("integration")
  public void handleUnexpectedException() {
    when(songDal.deleteSongById(anyString())).thenThrow(new RuntimeException("Unexpected exception"));
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/150"));
    Map<String, Object> response = songController.deleteSongById("150", request);
    assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, response.get("status"));
  }
  @Test
  @Tag("boundary")
  public void handleMissingDbQueryStatusData() {
    DbQueryStatus dbQueryStatus = new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK);
    dbQueryStatus.setData(null); // Setting data to null
    when(songDal.deleteSongById(anyString())).thenReturn(dbQueryStatus);
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/200"));
    Map<String, Object> response = songController.deleteSongById("200", request);
    assertEquals("Success", response.get("message"));
    assertEquals(DbQueryExecResult.QUERY_OK, response.get("status"));
  }
  @Test
  @Tag("integration")
  public void handleInvalidJSONResponseFromExternalService() throws Exception {
    when(songDal.deleteSongById(anyString())).thenReturn(new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK));
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/300"));
    when(client.newCall(any(Request.class)).execute()).thenReturn(externalResponse);
    when(externalResponse.body().string()).thenReturn("{Invalid JSON}");
    Map<String, Object> response = songController.deleteSongById("300", request);
    assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, response.get("status"));
  }
  @Test
  @Tag("invalid")
  public void handleUninitializedHttpClient() {
    songController.client = null; // Setting client to null
    when(songDal.deleteSongById(anyString())).thenReturn(new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK));
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/400"));
