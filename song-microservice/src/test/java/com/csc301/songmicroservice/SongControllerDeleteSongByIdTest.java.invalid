  public void verifyDbQueryStatusMessagePropagation() {
    DbQueryStatus dbQueryStatus = new DbQueryStatus("Custom success message", DbQueryExecResult.QUERY_OK);
    when(songDal.deleteSongById(anyString())).thenReturn(dbQueryStatus);
    when(request.getRequestURL()).thenReturn(new StringBuffer("http://localhost:8080/songs/500"));
    Map<String, Object> response = songController.deleteSongById("500", request);
    assertEquals("Custom success message", response.get("message"));
  }
