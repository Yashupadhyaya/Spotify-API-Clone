        requestMock = mock(HttpServletRequest.class);
        songController = new SongController(songDalMock);
    }
    @Test
    @Tag("valid")
    public void successfulDeleteSongById() {
        String validSongId = "123";
        DbQueryStatus mockStatus = new DbQueryStatus("Deletion successful", DbQueryExecResult.QUERY_OK);
        when(songDalMock.deleteSongById(validSongId)).thenReturn(mockStatus);
        when(requestMock.getRequestURL()).thenReturn(new StringBuffer("http://localhost/song"));
        Map<String, Object> response = songController.deleteSongById(validSongId, requestMock);
        assertEquals(mockStatus.getMessage(), response.get("message"));
        assertEquals("DELETE http://localhost/song", response.get("path"));
        assertEquals(DbQueryExecResult.QUERY_OK, response.get("status"), "Status should match");
    }
