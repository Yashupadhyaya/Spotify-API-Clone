    public void getSongArtistFullNameReturnsNullIfNotSet() {
        // Arrange
        Song song = new Song("TestSongName", null, "TestAlbum");
        // Act
        String actualArtistFullName = song.getSongArtistFullName();
        // Assert
        assertNull(actualArtistFullName, "Expected null if songArtistFullName is not set");
    }
