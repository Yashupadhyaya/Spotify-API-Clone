class SongGetJsonRepresentationTest {
    
    @Test
    @Tag("valid")
    public void validateJsonRepresentationWithPopulatedSong() {
        // Arrange
        ObjectId id = new ObjectId(); // Generate a unique ID
        Song song = new Song("Shape of You", "Ed Sheeran", "Divide");
        song.setId(id.toHexString()); // TODO: Ensure a valid method for setting '_id' exists
        // Act
        Map<String, String> result = song.getJsonRepresentation();
        // Assert
        assertEquals(id.toHexString(), result.get("id"));
        assertEquals("Shape of You", result.get("songName"));
        assertEquals("Ed Sheeran", result.get("songArtistFullName"));
        assertEquals("Divide", result.get("songAlbum"));
        assertEquals("0", result.get("songAmountFavourites")); // Default value
    }
