package com.csc301.songmicroservice;
import org.bson.types.ObjectId;
import org.junit.jupiter.api.Assertions;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.util.Map;
import org.junit.jupiter.api.*;
import java.util.HashMap;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;
import com.fasterxml.jackson.annotation.JsonIgnore;

public class SongGetJsonRepresentationTest {
    @Test
    @Tag("valid")
    public void verifyJsonRepresentationContainsAllExpectedFields() {
        // Arrange
        ObjectId mockId = new ObjectId();
        Song song = new Song("Sample Song", "Sample Artist", "Sample Album");
        song.setId(mockId);
        song.setSongAmountFavourites(999);
        // Act
        Map<String, String> jsonRepresentation = song.getJsonRepresentation();
        // Assert
        Assertions.assertEquals(mockId.toHexString(), jsonRepresentation.get("id"));
        Assertions.assertEquals("Sample Song", jsonRepresentation.get("songName"));
        Assertions.assertEquals("Sample Artist", jsonRepresentation.get("songArtistFullName"));
        Assertions.assertEquals("Sample Album", jsonRepresentation.get("songAlbum"));
        Assertions.assertEquals(String.valueOf(999), jsonRepresentation.get("songAmountFavourites"));
    }
    @Test
    @Tag("boundary")
    public void validateJsonHandlingOfNullValues() {
        // Arrange
        ObjectId mockId = new ObjectId();
        Song song = new Song(null, null, null);
        song.setId(mockId);
        // Act
        Map<String, String> jsonRepresentation = song.getJsonRepresentation();
        // Assert
        Assertions.assertEquals(mockId.toHexString(), jsonRepresentation.get("id"));
        Assertions.assertNull(jsonRepresentation.get("songName"));
        Assertions.assertNull(jsonRepresentation.get("songArtistFullName"));
        Assertions.assertNull(jsonRepresentation.get("songAlbum"));
        Assertions.assertEquals("0", jsonRepresentation.get("songAmountFavourites")); // Default value for long
    }
    @Test
    @Tag("valid")
    public void ensureObjectIdSerializationIsCorrect() {
        // Arrange
        ObjectId objectId = new ObjectId();
        Song song = new Song("Song Name", "Artist Name", "Album Name");
        song.setId(objectId);
        // Act
        Map<String, String> jsonRepresentation = song.getJsonRepresentation();
        // Assert
        Assertions.assertEquals(objectId.toHexString(), jsonRepresentation.get("id"));
    }
    @Test
    @Tag("boundary")
    public void validateNumericFieldStringConversion() {
        // Arrange
        ObjectId mockId = new ObjectId();
        Song song = new Song("Numeric Song", "Numeric Artist", "Numeric Album");
        song.setId(mockId);
        song.setSongAmountFavourites(123456789L);
        // Act
        Map<String, String> jsonRepresentation = song.getJsonRepresentation();
        // Assert
        Assertions.assertEquals(String.valueOf(123456789), jsonRepresentation.get("songAmountFavourites"));
    }
    @Test
    @Tag("boundary")
    public void validateUnsetStringFieldsResultInEmptyStrings() {
        // Arrange
        ObjectId mockId = new ObjectId();
        Song song = new Song(null, null, null);
        song.setId(mockId);
        // Act
        Map<String, String> jsonRepresentation = song.getJsonRepresentation();
        // Assert
        Assertions.assertEquals(mockId.toHexString(), jsonRepresentation.get("id"));
        Assertions.assertNull(jsonRepresentation.get("songName"));  // TODO change logic to "" if business requires
        Assertions.assertNull(jsonRepresentation.get("songArtistFullName"));  // TODO change logic to "" if business requires
        Assertions.assertNull(jsonRepresentation.get("songAlbum"));  // TODO change logic to "" if business requires
    }
    @Test
    @Tag("boundary")
    public void handleJsonSerializationForLargeInputFields() {
        // Arrange
        ObjectId mockId = new ObjectId();
        String largeString = "a".repeat(5000);  // 5000 characters of 'a'
        Song song = new Song(largeString, largeString, largeString);
        song.setId(mockId);
        // Act
        Map<String, String> jsonRepresentation = song.getJsonRepresentation();
        // Assert
        Assertions.assertEquals(largeString, jsonRepresentation.get("songName"));
        Assertions.assertEquals(largeString, jsonRepresentation.get("songArtistFullName"));
        Assertions.assertEquals(largeString, jsonRepresentation.get("songAlbum"));
    }
    @Test
    @Tag("integration")
    public void ensureNoDuplicateKeysInSerialization() {
        // Arrange
        ObjectId mockId = new ObjectId();
        Song song = new Song("Unique Song Name", "Unique Artist", "Unique Album");
        song.setId(mockId);
        // Act
        Map<String, String> jsonRepresentation = song.getJsonRepresentation();
        // Assert
        Assertions.assertTrue(jsonRepresentation.keySet().size() == 5); // Verify exactly 5 distinct keys
        Assertions.assertEquals(1, jsonRepresentation.keySet().stream().filter(key -> key.equals("songName")).count());
        Assertions.assertEquals(1, jsonRepresentation.keySet().stream().filter(key -> key.equals("songArtistFullName")).count());
        Assertions.assertEquals(1, jsonRepresentation.keySet().stream().filter(key -> key.equals("songAlbum")).count());
        Assertions.assertEquals(1, jsonRepresentation.keySet().stream().filter(key -> key.equals("songAmountFavourites")).count());
    }
}