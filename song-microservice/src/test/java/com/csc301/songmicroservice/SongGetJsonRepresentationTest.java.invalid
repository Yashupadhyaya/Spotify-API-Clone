public class SongGetJsonRepresentationTest {
    @Test
    @Tag("valid")
    public void mapContainsCorrectKeysAndValuesWhenAllFieldsAreSet() {
        Song song = new Song("Song Name", "Artist Full Name", "Album Name");
        song.songAmountFavourites = 10; // TODO: Update if needed
        Map<String, String> result = song.getJsonRepresentation();
        assertEquals("Song Name", result.get("songName"));
        assertEquals("Artist Full Name", result.get("songArtistFullName"));
        assertEquals("Album Name", result.get("songAlbum"));
        assertEquals("10", result.get("songAmountFavourites"));
        assertNotNull(result.get("id"));
    }
