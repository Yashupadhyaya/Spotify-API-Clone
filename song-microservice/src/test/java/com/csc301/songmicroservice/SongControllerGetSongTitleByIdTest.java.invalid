        String validSongTitle = "Mock Song Title";
        DbQueryStatus mockDbStatus = new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK);
        mockDbStatus.setData(validSongTitle);
        // Ensure Utils.getUrl mock returns a valid URL
        when(Utils.getUrl(mockRequest)).thenReturn("http://mock.url/test");
        when(mockSongDal.getSongTitleById(validSongId)).thenReturn(mockDbStatus);
        SongController songController = new SongController(mockSongDal);
        // Act
        Map<String, Object> response = songController.getSongTitleById(validSongId, mockRequest);
        // Assert
        assertEquals("GET http://mock.url/test", response.get("path"));
        assertEquals("Success", response.get("message"));
        assertEquals(DbQueryExecResult.QUERY_OK, (DbQueryExecResult) response.get("status"));
        assertEquals(validSongTitle, response.get("data"));
    }
