package com.csc301.songmicroservice;
import org.bson.types.ObjectId;
import org.junit.jupiter.api.*;
import org.mockito.Mockito;
import org.springframework.data.mongodb.core.MongoTemplate;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import com.mongodb.client.result.DeleteResult;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

@Tag("integration")
class SongDalImplAddSongTest {
    private MongoTemplate mockMongoTemplate;
    private SongDalImpl songDal;
    @BeforeEach
    void setUp() {
        mockMongoTemplate = Mockito.mock(MongoTemplate.class);
        songDal = new SongDalImpl(mockMongoTemplate);
    }
    @Test
    @Tag("valid")
    public void addSongValidSongReturnsSuccess() {
        Song song = new Song("Test Song", "Test Artist", "Test Album");
        when(mockMongoTemplate.insert(song, "songs")).thenReturn(song);
        DbQueryStatus result = songDal.addSong(song);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.OK, result.getdbQueryExecResult());
        assertNotNull(result.getData());
        assertTrue(result.getData() instanceof java.util.Map);
    }
    @Test
    @Tag("invalid")
    public void addSongInvalidSongReturnsError() {
        Song song = new Song(null, "Test Artist", "Test Album");
        DbQueryStatus result = songDal.addSong(song);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.ERR, result.getdbQueryExecResult());
        assertNull(result.getData());
        verify(mockMongoTemplate, never()).insert(any(Song.class), anyString());
    }
    @Test
    @Tag("boundary")
    public void addSongDatabaseInsertionFailsThenError() {
        Song song = new Song("Test Song", "Test Artist", "Test Album");
        when(mockMongoTemplate.insert(song, "songs")).thenReturn(null);
        DbQueryStatus result = songDal.addSong(song);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.ERR, result.getdbQueryExecResult());
        assertNull(result.getData());
    }
    @Test
    @Tag("boundary")
    public void addSongStatusIncludesCorrectHttpAction() {
        Song validSong = new Song("Test Song", "Test Artist", "Test Album");
        Song invalidSong = new Song(null, "Test Artist", null);
        when(mockMongoTemplate.insert(validSong, "songs")).thenReturn(validSong);
        DbQueryStatus validResult = songDal.addSong(validSong);
        DbQueryStatus invalidResult = songDal.addSong(invalidSong);
        assertEquals("POST", validResult.getMessage());
        assertEquals("POST", invalidResult.getMessage());
    }
    @Test
    @Tag("valid")
    public void addSongSuccessIncludesJsonRepresentation() {
        Song song = new Song("Test Song", "Test Artist", "Test Album");
        when(mockMongoTemplate.insert(song, "songs")).thenReturn(song);
        DbQueryStatus result = songDal.addSong(song);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.OK, result.getdbQueryExecResult());
        assertNotNull(result.getData());
        assertEquals(song.getJsonRepresentation(), result.getData());
    }
    @Test
    @Tag("invalid")
    public void addSongNullSongReturnsError() {
        DbQueryStatus result = songDal.addSong(null);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.ERR, result.getdbQueryExecResult());
        assertNull(result.getData());
        verify(mockMongoTemplate, never()).insert(any(Song.class), anyString());
    }
    @Test
    @Tag("invalid")
    public void addSongNoDbInteractionOnInvalidInput() {
        Song invalidSong = new Song(null, "Test Artist", null);
        DbQueryStatus result = songDal.addSong(invalidSong);
        verify(mockMongoTemplate, never()).insert(any(Song.class), anyString());
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.ERR, result.getdbQueryExecResult());
        assertNull(result.getData());
    }
    @Test
    @Tag("invalid")
    public void addSongErrorMessageIncludedOnFailure() {
        Song invalidSong = new Song(null, null, "Test Album");
        DbQueryStatus result = songDal.addSong(invalidSong);
        assertEquals("POST", result.getMessage());
        assertEquals(DbQueryExecResult.ERR, result.getdbQueryExecResult());
        assertNull(result.getData());
    }
}