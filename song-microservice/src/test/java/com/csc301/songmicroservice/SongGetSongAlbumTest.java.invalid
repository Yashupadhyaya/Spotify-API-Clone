package com.csc301.songmicroservice;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import java.util.HashMap;
import java.util.Map;
import org.bson.types.ObjectId;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;
import com.fasterxml.jackson.annotation.JsonIgnore;

public class SongGetSongAlbumTest {
    @Test
    @Tag("valid")
    public void retrieveNonNullAlbumName() {
        Song song = new Song("Test Song", "Test Artist", "Initial Album");
        song.setSongAlbum("Greatest Hits");
        assertEquals("Greatest Hits", song.getSongAlbum());
    }
    @Test
    @Tag("invalid")
    public void retrieveNullAlbumName() {
        Song song = new Song("Test Song", "Test Artist", null);
        assertNull(song.getSongAlbum());
    }
    @Test
    @Tag("boundary")
    public void retrieveEmptyStringAlbumName() {
        Song song = new Song("Test Song", "Test Artist", "");
        song.setSongAlbum("");
        assertEquals("", song.getSongAlbum());
    }
    @Test
    @Tag("boundary")
    public void retrieveUpdatedAlbumName() {
        Song song = new Song("Test Song", "Test Artist", "First Album");
        song.setSongAlbum("Second Album");
        song.setSongAlbum("Third Album");
        assertEquals("Third Album", song.getSongAlbum());
    }
    @Test
    @Tag("boundary")
    public void retrieveSpecialCharacterAlbumName() {
        Song song = new Song("Test Song", "Test Artist", "");
        song.setSongAlbum("Songs & Stories #10");
        assertEquals("Songs & Stories #10", song.getSongAlbum());
    }
    @Test
    @Tag("valid")
    public void unrelatedFieldAssignment() {
        Song song = new Song("Another Song", "Another Artist", null);
        song.setSongName("Updated Name");
        song.setSongArtistFullName("Updated Artist");
        assertNull(song.getSongAlbum());
    }
    @Test
    @Tag("boundary")
    public void retrieveAlbumNameWithSpaces() {
        Song song = new Song("Test Song", "Test Artist", "  Album With Spaces  ");
        song.setSongAlbum("  Album With Spaces  ");
        assertEquals("  Album With Spaces  ", song.getSongAlbum());
    }
    @Test
    @Tag("integration")
    public void retrieveAlbumNameAfterObjectIdSet() {
        Song song = new Song("Test Song", "Test Artist", "Assigned Album");
        song.setId(new ObjectId());
        song.setSongAlbum("Assigned Album");
        assertEquals("Assigned Album", song.getSongAlbum());
    }
    @Test
    @Tag("boundary")
    public void retrieveAlbumNameEqualConstant() {
        Song song = new Song("Test Song", "Test Artist", "");
        song.setSongAlbum("songAlbum"); // TODO Replace with the actual constant value KEY_SONG_ALBUM if defined.
        assertEquals("songAlbum", song.getSongAlbum());
    }
}