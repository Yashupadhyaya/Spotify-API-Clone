package com.csc301.songmicroservice;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import java.util.HashMap;
import java.util.Map;
import org.bson.types.ObjectId;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;
import com.fasterxml.jackson.annotation.JsonIgnore;

public class SongGetSongAlbumTest {
    private Song testSong;
    @BeforeEach
    public void setUp() {
        testSong = new Song("Dummy Song Name", "Dummy Artist Name", "Dummy Album Name");
    }
    @Test
    @Tag("valid")
    public void getSongAlbumReturnsCorrectAlbumName() {
        testSong.setSongAlbum("Thriller");
        String actualAlbum = testSong.getSongAlbum();
        assertEquals("Thriller", actualAlbum, "The method should correctly return the album name.");
    }
    @Test
    @Tag("invalid")
    public void getSongAlbumReturnsNullWhenNotSet() {
        testSong.setSongAlbum(null); 
        String actualAlbum = testSong.getSongAlbum();
        assertNull(actualAlbum, "The method should return null when the album name is not set.");
    }
    @Test
    @Tag("valid")
    public void getSongAlbumReturnsUpdatedAlbumName() {
        testSong.setSongAlbum("Back in Black");
        testSong.setSongAlbum("Let It Be");
        String actualAlbum = testSong.getSongAlbum();
        assertEquals("Let It Be", actualAlbum, "The method should return the updated album name.");
    }
    @Test
    @Tag("boundary")
    public void getSongAlbumHandlesSpecialCharacters() {
        testSong.setSongAlbum("Songs @ Midnight #2023");
        String actualAlbum = testSong.getSongAlbum();
        assertEquals("Songs @ Midnight #2023", actualAlbum, "The method should correctly return album names with special characters.");
    }
    @Test
    @Tag("boundary")
    public void getSongAlbumReturnsEmptyString() {
        testSong.setSongAlbum(""); 
        String actualAlbum = testSong.getSongAlbum();
        assertEquals("", actualAlbum, "The method should correctly return an empty string when the album name is explicitly set to ''");
    }
    @Test
    @Tag("valid")
    public void getSongAlbumReturnsAlbumWithoutInterference() {
        testSong.setSongName("Divide Song");
        testSong.setSongArtistFullName("Ed Sheeran");
        testSong.setSongAlbum("Divide");
        String actualAlbum = testSong.getSongAlbum();
        assertEquals("Divide", actualAlbum, "The method should return the album name unaffected by unrelated fields.");
    }
    @Test
    @Tag("boundary")
    public void getSongAlbumHandlesVeryLongStrings() {
        String longAlbumName = "A".repeat(10000); // TODO: Adjust the length as needed for testing
        testSong.setSongAlbum(longAlbumName);
        String actualAlbum = testSong.getSongAlbum();
        assertEquals(longAlbumName, actualAlbum, "The method should correctly handle very long album names.");
    }
}