    @BeforeEach
    public void setUp() {
        songDal = Mockito.mock(SongDal.class);
        songController = new SongController(songDal);
        mockRequest = Mockito.mock(HttpServletRequest.class);
    }
    @Test
    @Tag("valid")
    public void addSongWithValidParameters() {
        Map<String, String> params = new HashMap<>();
        params.put(Song.KEY_SONG_NAME, "Valid Song Name");
        params.put(Song.KEY_SONG_ARTIST_FULL_NAME, "Valid Artist");
        params.put(Song.KEY_SONG_ALBUM, "Valid Album");
        DbQueryStatus mockDbQueryStatus = new DbQueryStatus("Success", DbQueryExecResult.QUERY_OK);
        mockDbQueryStatus.setData(new HashMap<>());
        when(mockRequest.getRequestURI()).thenReturn("/api/song");
        when(songDal.addSong(any(Song.class))).thenReturn(mockDbQueryStatus);
        Map<String, Object> result = songController.addSong(params, mockRequest);
        assertEquals("POST /api/song", result.get("path"));
        assertEquals(DbQueryExecResult.QUERY_OK, mockDbQueryStatus.getdbQueryExecResult());
        assertEquals("Success", result.get("message"));
    }
