        // Assert
        assertEquals("GET", result.getMessage());
        assertEquals(songDalImpl.ERR, result.getdbQueryExecResult());
        assertNull(result.getData());
    }
    @Test
    @Tag("boundary")
    public void databaseExceptionIsHandled() {
        // Arrange
        String songIdCausingException = new ObjectId().toHexString();
        when(mongoTemplate.findById(new ObjectId(songIdCausingException), Song.class)).thenThrow(new RuntimeException());
        // Act
        DbQueryStatus result = songDalImpl.findSongById(songIdCausingException);
        // Assert
        assertEquals("GET", result.getMessage());
        assertEquals(songDalImpl.ERR, result.getdbQueryExecResult());
        assertNull(result.getData());
    }
    @Test
    @Tag("invalid")
