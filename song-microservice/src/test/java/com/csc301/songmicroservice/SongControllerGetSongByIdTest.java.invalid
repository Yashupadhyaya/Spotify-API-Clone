    validQueryStatus.setData(new HashMap<>());
    when(songDalMock.findSongById(validSongId)).thenReturn(validQueryStatus);
    when(Utils.getUrl(requestMock)).thenReturn("/api/songs");
    Map<String, Object> response = songController.getSongById(validSongId, requestMock);
    assertEquals("GET /api/songs", response.get("path"));
    assertEquals("Success", response.get("message"));
    assertEquals(validQueryStatus.getData(), response.get("data"));
  }
