package com.csc301.songmicroservice;
import java.util.HashMap;
import java.util.Map;
import org.bson.types.ObjectId;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;
import com.fasterxml.jackson.annotation.JsonIgnore;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class SongGetSongNameTest {
    @Test
    @Tag("valid")
    public void ensureSongNameReturnedWhenSet() {
        Song song = new Song("Imagine", "John Lennon", "Imagine Album");
        String expectedSongName = "Imagine";
        assertEquals(expectedSongName, song.getSongName());
    }
    @Test
    @Tag("valid")
    public void verifyNullReturnedWhenNoSongNameSet() {
        Song song = new Song(null, "Unknown Artist", "Unknown Album");
        assertNull(song.getSongName());
    }
    @Test
    @Tag("boundary")
    public void handleEmptyStringAsSongName() {
        Song song = new Song("", "Unknown Artist", "Unknown Album");
        assertEquals("", song.getSongName());
    }
    @Test
    @Tag("valid")
    public void validateSpecialCharacterSongName() {
        Song song = new Song("Love&Peace@2023", "Unknown Artist", "Unknown Album");
        String expectedSongName = "Love&Peace@2023";
        assertEquals(expectedSongName, song.getSongName());
    }
    @Test
    @Tag("boundary")
    public void testLongSongNameRetrieval() {
        // TODO: Change the value of `longSongName` if test requires different length
        String longSongName = "a".repeat(5000);
        Song song = new Song(longSongName, "Unknown Artist", "Unknown Album");
        assertEquals(longSongName, song.getSongName());
    }
    @Test
    @Tag("integration")
    public void ensureSongNameRetrievalDoesNotAffectOtherFields() {
        ObjectId id = new ObjectId();
        String expectedSongName = "Bohemian Rhapsody";
        Song song = new Song(expectedSongName, "Queen", "A Night at the Opera");
        song.setId(id);
        assertEquals(expectedSongName, song.getSongName());
        assertEquals("Queen", song.getSongArtistFullName());
        assertEquals("A Night at the Opera", song.getSongAlbum());
        assertEquals(id.toHexString(), song.getId());
    }
    @Test
    @Tag("invalid")
    public void verifyNullAssignmentBeforeRetrieval() {
        Song song = new Song(null, "Unknown Artist", "Unknown Album");
        song.setSongName(null);
        assertNull(song.getSongName());
    }
    @Test
    @Tag("valid")
    public void checkUnicodeCharacterSongName() {
        Song song = new Song("こんにちは", "Unknown Artist", "Unknown Album");
        String expectedSongName = "こんにちは";
        assertEquals(expectedSongName, song.getSongName());
    }
}