import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.springframework.data.mongodb.core.MongoTemplate;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

public class SongDalImplUpdateSongFavouritesCountTest {
    private MongoTemplate mockMongoTemplate;
    private SongDalImpl songDalImpl;
    @BeforeEach
    public void setUp() {
        mockMongoTemplate = Mockito.mock(MongoTemplate.class);
        songDalImpl = new SongDalImpl(mockMongoTemplate);
    }
    @Test
    @Tag("valid")
    public void incrementSongFavouritesCountSuccessfully() {
        // Arrange
        String songId = new ObjectId().toString();
        Song mockSong = new Song("SongName", "ArtistName", "AlbumName");
        mockSong.setSongAmountFavourites(5);
        when(mockMongoTemplate.findById(new ObjectId(songId), Song.class)).thenReturn(mockSong);
        when(mockMongoTemplate.save(mockSong)).thenAnswer(invocation -> invocation.getArgument(0));
        // Act
        DbQueryStatus result = songDalImpl.updateSongFavouritesCount(songId, false);
        // Assert
        assertEquals("OK", result.getdbQueryExecResult().name());
        assertEquals(6L, ((Song) mockMongoTemplate.save(mockSong)).getSongAmountFavourites());
    }
    @Test
    @Tag("valid")
    public void decrementSongFavouritesCountSuccessfully() {
        // Arrange
        String songId = new ObjectId().toString();
        Song mockSong = new Song("SongName", "ArtistName", "AlbumName");
        mockSong.setSongAmountFavourites(5);
        when(mockMongoTemplate.findById(new ObjectId(songId), Song.class)).thenReturn(mockSong);
        when(mockMongoTemplate.save(mockSong)).thenAnswer(invocation -> invocation.getArgument(0));
        // Act
        DbQueryStatus result = songDalImpl.updateSongFavouritesCount(songId, true);
        // Assert
        assertEquals("OK", result.getdbQueryExecResult().name());
        assertEquals(4L, ((Song) mockMongoTemplate.save(mockSong)).getSongAmountFavourites());
    }
    @Test
    @Tag("invalid")
    public void songNotFoundInDatabaseUpdateSongFavouritesCount() {
        // Arrange
        String songId = new ObjectId().toString();
        when(mockMongoTemplate.findById(new ObjectId(songId), Song.class)).thenReturn(null);
        // Act
