package com.csc301.songmicroservice;
import com.mongodb.client.result.DeleteResult;
import org.bson.types.ObjectId;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.data.mongodb.core.MongoTemplate;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

@ExtendWith(MockitoExtension.class)
public class SongDalImplDeleteSongByIdTest {
    @Mock
    private MongoTemplate mongoTemplate;
    @InjectMocks
    private SongDalImpl songDalImpl;
    @Test
    @Tag("valid")
    public void successfullyDeleteSongWhenSongExists() {
        // Arrange
        String songId = "validObjectId"; // TODO: Replace with actual ObjectId format if needed
        Song mockedSong = mock(Song.class);
        DeleteResult mockedDeleteResult = mock(DeleteResult.class);
        when(mongoTemplate.findById(any(ObjectId.class), eq(Song.class))).thenReturn(mockedSong);
        when(mongoTemplate.remove(eq(mockedSong), eq("songs"))).thenReturn(mockedDeleteResult);
        when(mockedDeleteResult.wasAcknowledged()).thenReturn(true);
        // Act
        DbQueryStatus result = songDalImpl.deleteSongById(songId);
        // Assert
        assertEquals("DELETE", result.getMessage());
        assertEquals(songDalImpl.OK, result.getdbQueryExecResult());
        verify(mongoTemplate, times(1)).findById(any(ObjectId.class), eq(Song.class));
        verify(mongoTemplate, times(1)).remove(eq(mockedSong), eq("songs"));
    }
    @Test
    @Tag("invalid")
    public void deleteSongWhenSongDoesNotExist() {
        // Arrange
        String songId = "validObjectId"; // TODO: Replace with actual ObjectId format if needed
        when(mongoTemplate.findById(any(ObjectId.class), eq(Song.class))).thenReturn(null);
        // Act
        DbQueryStatus result = songDalImpl.deleteSongById(songId);
        // Assert
        assertEquals("DELETE", result.getMessage());
        assertEquals(songDalImpl.ERR404, result.getdbQueryExecResult());
    }
    @Test
    @Tag("boundary")
    public void handleInvalidSongIdFormat() {
        // Arrange
        String invalidSongId = "invalidObjectId";
        doThrow(IllegalArgumentException.class).when(mongoTemplate).findById(any(ObjectId.class), eq(Song.class));
        // Act
        DbQueryStatus result = songDalImpl.deleteSongById(invalidSongId);
        // Assert
        assertEquals("DELETE", result.getMessage());
        assertEquals(songDalImpl.ERR, result.getdbQueryExecResult());
    }
    @Test
    @Tag("invalid")
    public void handleDatabaseFailureOnSongDeletion() {
        // Arrange
        String songId = "validObjectId"; // TODO: Replace with actual ObjectId format if needed
        Song mockedSong = mock(Song.class);
        when(mongoTemplate.findById(any(ObjectId.class), eq(Song.class))).thenReturn(mockedSong);
        doThrow(RuntimeException.class).when(mongoTemplate).remove(eq(mockedSong), eq("songs"));
        // Act
        DbQueryStatus result = songDalImpl.deleteSongById(songId);
        // Assert
        assertEquals("DELETE", result.getMessage());
        assertEquals(songDalImpl.ERR, result.getdbQueryExecResult());
