    @Test
    @Tag("boundary")
    public void handleUnacknowledgedSongDeletionRequest() {
        // Arrange
        String songId = "validObjectId"; // TODO: Replace with actual ObjectId format if needed
        Song mockedSong = mock(Song.class);
        DeleteResult mockedDeleteResult = mock(DeleteResult.class);
        when(mongoTemplate.findById(any(ObjectId.class), eq(Song.class))).thenReturn(mockedSong);
        when(mongoTemplate.remove(eq(mockedSong), eq("songs"))).thenReturn(mockedDeleteResult);
        when(mockedDeleteResult.wasAcknowledged()).thenReturn(false);
        // Act
