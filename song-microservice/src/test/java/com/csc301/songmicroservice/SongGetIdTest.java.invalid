package com.csc301.songmicroservice;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.bson.types.ObjectId;
import org.junit.jupiter.api.*;
import java.util.HashMap;
import java.util.Map;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.mapping.Document;
import com.fasterxml.jackson.annotation.JsonIgnore;

public class SongGetIdTest {
    @Test
    @Tag("valid")
    public void getIdShouldReturnHexStringForValidObjectId() {
        // Arrange
        ObjectId objectId = new ObjectId();
        Song song = new Song("Dummy Song", "Dummy Artist", "Dummy Album");
        song.setId(objectId);
        // Act
        String actualId = song.getId();
        // Assert
        assertEquals(objectId.toHexString(), actualId);
    }
}